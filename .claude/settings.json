{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm turbo run test:*)",
      "Bash(pnpm turbo run lint:*)",
      "Bash(pnpm turbo run typecheck:*)",
      "Bash(pnpm turbo run build:*)",
      "Bash(pnpm --filter * test:*)",
      "Bash(pnpm --filter * lint:*)",
      "Bash(pnpm --filter * typecheck:*)",
      "Bash(pnpm --filter * codegen:*)",
      "Bash(pnpm --filter * build:*)",
      "Bash(pnpm --filter * exec playwright test:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format:*)",
      "Bash(uv run pyright:*)",
      "Bash(uv run python manage.py check:*)",
      "Bash(uv run python manage.py makemigrations:*)",
      "Bash(uv run python manage.py migrate:*)",
      "Bash(uv run python manage.py showmigrations:*)",
      "Bash(uv run python manage.py sqlmigrate:*)",
      "Bash(uv run python manage.py export_schema:*)",
      "Bash(uv run python manage.py privacy_delete * --dry-run:*)",
      "Bash(docker build -t taskbeavo-backend:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose run --rm django uv run pytest:*)",
      "Bash(maestro test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "ask": [
      "Bash(eas:*)",
      "Bash(npx eas:*)",
      "Bash(npx eas-cli:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "Bash(render:*)",
      "Bash(aws:*)",
      "Bash(stripe:*)",
      "Bash(*sk_live*)",
      "Bash(*rk_live*)",
      "Bash(*pk_live*)",
      "Bash(*--live*)",
      "Bash(uv run python manage.py privacy_delete:*)",
      "Bash(uv run python manage.py privacy_export:*)",
      "Bash(uv run python manage.py flush:*)",
      "Bash(uv run python manage.py shell:*)",
      "Bash(docker compose down -v:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./**/.env.production)",
      "Read(./**/.env.production.local)",
      "Read(./**/.env.prod)",
      "Read(./**/*.p12)",
      "Edit(./**/.env.production)",
      "Edit(./**/.env.production.local)",
      "Edit(./**/.env.prod)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push *+*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git push * develop*)",
      "Bash(git push * main*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * -n *)"
    ]
  }
}
