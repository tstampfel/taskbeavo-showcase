# Copy to backend/.env for local overrides. Never commit real values.
# Leave DJANGO_SETTINGS_MODULE commented out locally: manage.py, asgi.py and celery.py then
# use config.settings.local and pytest uses config.settings.test. An empty value would
# override those defaults. Deployed images set config.settings.production.
# DJANGO_SETTINGS_MODULE=config.settings.local
# Every empty KEY= below falls back to the settings module's default.
# local | test | staging | production (production turns GraphQL introspection off)
APP_ENV=
SECRET_KEY=
# Signs access and WebSocket JWTs; local and test fall back to SECRET_KEY.
JWT_SIGNING_KEY=
# Emails. Local and test default to the console; every deployed environment must set a
# real backend or the app refuses to start: core.resend.ResendEmailBackend (needs
# RESEND_API_KEY) or django.core.mail.backends.smtp.EmailBackend (host, user, password).
EMAIL_BACKEND=
RESEND_API_KEY=
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# The launch date (YYYY-MM-DD): the first service fee price list takes effect on it and
# /fees shows it. Required outside local and test, which default to 2026-11-01.
# Production and staging: 2027-01-01 (render.yaml).
FEE_LAUNCH_DATE=
# Whether the service fee includes VAT: INCLUDED or NOT_CHARGED. Required outside local and
# test (which default to UNDECIDED); deployed environments refuse to start while it is
# missing or UNDECIDED. Production and staging: NOT_CHARGED (render.yaml; BEAV-194, outside
# the VAT system under ZPDV čl. 90 st. 1, docs/vat-position.md).
FEE_VAT=NOT_CHARGED
# Comma-separated addresses for the VAT threshold alerts (support and the founder); unset
# means TASKBEAVO_CONTACT_EMAIL.
VAT_ALERT_EMAILS=
# Exactly the same value as the web app's WEB_PROXY_SECRET on Vercel; required outside
# local and test. The /api/graphql route handler sends it with each visitor's address
# for the mutation rate limit.
WEB_PROXY_SECRET=
# Web app origin for links in notification emails; required outside local and test
# (defaults to http://localhost:3000 locally).
WEB_APP_URL=
# TaskBeavo's trader identity (imprint) for the contract confirmation email; required
# outside local and test (placeholders locally until BEAV-177).
TASKBEAVO_LEGAL_NAME=
TASKBEAVO_OIB=
TASKBEAVO_ADDRESS=
TASKBEAVO_CONTACT_EMAIL=
# Optional Expo access token for push ("enhanced security for push" in the Expo project).
EXPO_ACCESS_TOKEN=
DEBUG=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# Host use (manage.py runserver, pytest): the compose postgis service is on host port 55432.
# Inside compose, DATABASE_URL is set to postgis:5432 by docker-compose.yml.
DATABASE_URL=postgis://taskbeavo:taskbeavo@localhost:55432/taskbeavo
# Render only: Neon's direct (unpooled) connection string, used by scripts/predeploy.sh
# for migrations. DATABASE_URL there is the pooled one.
DATABASE_URL_DIRECT=
DB_CONN_MAX_AGE=
REDIS_URL=
LOG_LEVEL=
GRAPHQL_MAX_DEPTH=
GRAPHQL_MAX_TOKENS=
GRAPHQL_MAX_ALIASES=
# Stripe TEST mode only (sk_test_... or rk_test_...). Live keys exist only in Render.
# The stripe-cli compose service refuses any other key. STRIPE_WEBHOOK_SECRET is the
# whsec_... that `stripe listen` prints when it starts (see `docker compose logs stripe-cli`);
# when deployed it lists the platform and Connect endpoint secrets, comma-separated.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Demo payments (docs/demo/README.md): 1 runs checkout, refunds and payouts against an
# in-process stand-in for Stripe, without Stripe keys. A demo stub; refused in production
# and next to a live key. `manage.py seed_demo` needs it.
DEMO_PAYMENTS=

# Everything below is set on Render (render.yaml env groups, docs/deploy-render.md).
# Leave empty locally unless you are working on that integration.
# Sentry EU. Off while SENTRY_DSN is empty. The release is RENDER_GIT_COMMIT, which
# Render sets on every deploy; SENTRY_ENVIRONMENT defaults to APP_ENV.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Honeycomb EU: https://api.eu1.honeycomb.io and x-honeycomb-team=<key>. Tracing is off
# while OTEL_EXPORTER_OTLP_HEADERS is empty. OTEL_SERVICE_NAME: taskbeavo-api, -worker or -beat.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=
# Cloudflare R2 (presigned photo uploads, uploads/storage.py; bucket setup in docs/r2.md).
# Required when deployed; locally uploads fail until these are set. R2_ENDPOINT_URL
# defaults to the account's EU-jurisdiction endpoint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ENDPOINT_URL=
# Encrypts phone numbers (and later OIB and IBAN) at rest: comma-separated Fernet keys,
# the first encrypts. Optional locally (derived from SECRET_KEY); required when deployed.
FIELD_ENCRYPTION_KEY=
# Keys the digests behind "one verified number per account". Optional locally (derived
# from SECRET_KEY); required when deployed. Never rotate it without running
# `manage.py recompute_pii_digests` right after.
PII_DIGEST_KEY=
# SMS for phone codes (core/sms.py). Locally the console backend prints the message;
# deployed it must be core.infobip.InfobipSmsBackend with the INFOBIP_* values.
SMS_BACKEND=
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=
# REGION=sender pairs; +1 numbers get no SMS until a numeric sender is set for them.
INFOBIP_SENDER_BY_REGION=
# SMS caps (defaults in config/settings/base.py): PHONE_CODE_REQUESTS_PER_HOUR_PER_COUNTRY,
# PHONE_CODE_COUNTRY_HOURLY_CAPS ("HR=200,DE=100"), PHONE_CODE_SMS_PER_DAY, and
# PHONE_DENIED_REGIONS to switch a country off in an emergency.
# Google and Apple sign-in (accounts/providers.py): the client IDs an ID token may be
# issued for. Public identifiers, not secrets; a provider with none set refuses sign-in.
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
# The iOS app's bundle ID and the Sign in with Apple Services ID (web).
APPLE_BUNDLE_ID=
APPLE_SERVICES_ID=
# Fiscalization. On Render the certificate is the secret file /etc/secrets/fina.p12.
FINA_CERT_PATH=
FINA_CERT_PASSWORD=
CIS_URL=
RESEND_API_KEY=
POSTHOG_KEY=
EXPO_ACCESS_TOKEN=
# MaxMind GeoLite2 City (accounts/geolite.py, BEAV-190): a writable database path (e.g.
# /app/var/geoip/GeoLite2-City.mmdb locally, /tmp/geoip/GeoLite2-City.mmdb on Render), and the
# free MaxMind account the web process downloads it with, weekly. Optional: without the key
# nothing is downloaded and the new-sign-in email names only the device. The key is a secret.
GEOIP_CITY_DATABASE=
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
